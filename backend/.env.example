# Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=chaintrace_super_secret_jwt_key_2026_change_in_production
FRONTEND_URL=http://localhost:3000

# Cloud Database (MongoDB Atlas) - Leave commented/empty to use local JSON file storage
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chaintrace?retryWrites=true&w=majority

